    "sections": {
      "e2e": {
        "title": "End-to-End Encryption",
        "p1before": "Every message is encrypted on your device ",
        "p1bold": "before",
        "p1after": " being sent. The server never receives plaintext — it only receives encrypted data it cannot read.",
        "p2": "Only you and the recipient hold the keys to decrypt messages. No intermediaries, no possible interception."
      },
      "x3dh": {
        "title": "X3DH — The First Handshake",
        "p1after": " is the protocol Alpha Chat uses to establish a secure session between two users who have never spoken before.",
        "p2": "Cryptographic keys are exchanged so that no key ever travels in plaintext over the network. Even if an attacker intercepted all packets, they couldn't extract anything useful.",
        "p3": "The result is a shared secret, known only to the two participants, used as the basis for the Double Ratchet."
      },
      "ratchet": {
        "title": "Double Ratchet — One Key Per Message",
        "p1after": " generates a unique cryptographic key for every single message. The key is used once and then deleted.",
        "forwardSecrecyTitle": "Forward Secrecy",
        "forwardSecrecyDesc": "Even if a future key were compromised, previous messages remain safe.",
        "postCompromiseTitle": "Post-Compromise Security",
        "postCompromiseDesc": "After a compromise, the system automatically \"heals\" itself with subsequent messages."
      },
      "media": {
        "title": "Encrypted Media — AES-256-GCM",
        "p1before": "Photos, videos, audio and documents are encrypted with ",
        "p1after": " directly on your device before upload.",
        "p2": "The server only sees opaque encrypted blobs. Even with physical database access, no file can be seen, heard, or read."
      },
      "zk": {
        "title": "Zero Knowledge",
        "p1": "The server knows only the bare minimum needed to deliver messages."
      },
      "ghost": {
        "title": "Ghost Mode",
        "p1": "You're as invisible as you want. You can choose to hide every trace of your presence.",
        "lastSeenTitle": "Hidden last seen",
        "lastSeenDesc": "No one sees when you last used the app.",
        "onlineTitle": "Hidden online status",
        "onlineDesc": "You never appear as \"online\" in the contact list.",
        "receiptsTitle": "Read receipts disabled",
        "receiptsDesc": "Ticks don't show whether you've read the message."
      },
      "burn": {
        "title": "Burn After Read",
        "p1before": "Some messages must disappear after being read. With ",
        "p1bold": "Burn After Read",
        "p1after": " the message self-destructs as soon as the recipient opens it.",
        "p2": "Nothing remains — neither on the recipient's device nor on the server. As if it never existed."
      },
      "disappearing": {
        "title": "Disappearing messages",
        "p1": "Every conversation can have a disappearing timer. After the set time (from 5 seconds to 7 days), messages are automatically deleted from both devices.",
        "p2": "Ideal for sensitive conversations that shouldn't leave traces over time."
      },
      "destroy": {
        "title": "Secure Destroy",
        "p1bold": "Secure Destroy",
        "p1after": " permanently deletes a message from all devices and from the server.",
        "p2": "Unlike regular deletion — which can leave traces — Secure Destroy removes the message permanently and irreversibly, leaving no sign of its existence in the conversation."
      },
      "safety": {
        "title": "Safety Number — Identity Verification",
        "p1before": "The ",
        "p1bold": "Safety Number",
        "p1after": " is a unique cryptographic fingerprint of your Signal session with a contact. By comparing it with your contact, you can verify that no one has intercepted the communication.",
        "mitmTitle": "MITM Protection",
        "mitmDesc": "Detects Man-in-the-Middle attacks before they can compromise the conversation.",
        "qrTitle": "QR Code",
        "qrDesc": "Scan the contact's QR for instant verification.",
        "fingerprintTitle": "Numeric fingerprint",
        "fingerprintDesc": "Compare the 12 groups of 5 digits in person or over the phone."
      },
      "deviceSecurity": {
        "title": "Device security",
        "p1": "Alpha Chat protects your data from a physical standpoint too. If someone has your phone, they can't open the app without authentication."
      },
      "emergencyLock": {
        "title": "Emergency Lock",
        "p1bold": "Emergency Lock",
        "p1after": " immediately disconnects all your devices and revokes all active sessions. The account remains intact and recoverable.",
        "scenario1": "Phone gets stolen",
        "scenario2": "You lose your device",
        "scenario3": "You suspect unauthorized access",
        "hint": "Accessible from any browser via the Emergency Portal — even without your phone."
      },
      "phoenix": {
        "title": "Phoenix Protocol"
      },
      "multidevice": {
        "title": "Multi-Device",
        "p1": "You can use Alpha Chat on multiple devices simultaneously. Each device establishes an independent Signal session — it doesn't share keys with the others.",
        "p2": "You can individually revoke any device at any time from the Devices page, without having to change your password or invalidate the others."
      },
      "block": {
        "title": "Block users",
        "p1": "You can block any user at any time. Once blocked, they can no longer send you messages, see your profile, or know you exist on Alpha Chat.",
        "p2": "Blocking is silent: the blocked user receives no notification."
      }
    }

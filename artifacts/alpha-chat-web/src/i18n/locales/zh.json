        "title": "End-to-End Encryption",
        "p1before": "Every message is encrypted on your device ",
        "p1bold": "before",
        "p1after": " being sent. The server never receives plaintext — it only receives encrypted data it cannot read.",
        "p2": "Only you and the recipient hold the keys to decrypt messages. No intermediaries, no possible interception."
      },
      "x3dh": {
        "title": "X3DH — The First Handshake",
        "p1after": " is the protocol Alpha Chat uses to establish a secure session between two users who have never spoken before.",
        "p2": "Cryptographic keys are exchanged so that no key ever travels in plaintext over the network. Even if an attacker intercepted all packets, they couldn't extract anything useful.",
        "p3": "The result is a shared secret, known only to the two participants, used as the basis for the Double Ratchet."
      },
      "ratchet": {
        "title": "Double Ratchet — One Key Per Message",
        "p1after": " generates a unique cryptographic key for every single message. The key is used once and then deleted.",
        "forwardSecrecyTitle": "Forward Secrecy",
        "forwardSecrecyDesc": "Even if a future key were compromised, previous messages remain safe.",
        "postCompromiseTitle": "Post-Compromise Security",
        "postCompromiseDesc": "After a compromise, the system automatically \"heals\" itself with subsequent messages."
      },
      "media": {
        "title": "Encrypted Media — AES-256-GCM",
        "p1before": "Photos, videos, audio and documents are encrypted with ",
